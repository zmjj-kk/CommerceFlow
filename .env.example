# ============================================================
# 三组上游各自直连,没有网关。三个 KEY 位是独立的,用同一家上游就填同一个值。
# ============================================================

# --- 聊天 ---
# CHAT_MODEL 必须是上游认的真实模型名(没有网关就没有别名这一层,写错会被上游拒)。
# 下面这组是硅基流动,和嵌入、重排同一家,注册一个账号就能跑完整门课。
# 换成 DeepSeek 官方就是:
#   CHAT_BASE_URL=https://api.deepseek.com/v1
#   CHAT_MODEL=deepseek-v4-flash
CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
CHAT_API_KEY=sk-xxx

# --- 思考链 ---
# 必须关。开着的话一句客服回复要 22 秒、token 多花 4 倍(实测 22.4s/318 → 1.4s/16),
# ch01 的流式体验和 ch05 的多步 Agent 都没法看。
# 这个参数名在 OpenAI 协议下是通用的,但能不能关取决于模型:硅基流动的 DeepSeek 和
# MiniMax-M3 能关,MiniMax-M2.x 传了会被静默忽略(官方文档明确说 M2.x 关不掉)。
CHAT_THINKING=disabled
# 开着时的强度,关掉时不用管:low / high / max
# CHAT_REASONING_EFFORT=
# MiniMax 专属,别家不需要。碰到关不掉思考链的模型时开它,让思考进 reasoning_content
# 独立字段,而不是混在 content 里的 <think>——否则结构化输出(意图识别、裁判)会解析失败。
# CHAT_REASONING_SPLIT=true

# --- 嵌入(bge-m3) ---
# BASE_URL 有内置默认值(硅基流动),换上游才需要取消注释
EMBED_API_KEY=sk-xxx
# EMBED_BASE_URL=https://api.siliconflow.cn/v1

# --- 重排(bge-reranker-v2-m3) ---
# 走的是 Jina / Cohere 那套 /rerank 形状,不是 OpenAI 协议
RERANK_API_KEY=sk-xxx
# RERANK_BASE_URL=https://api.siliconflow.cn/v1

TOKEN_BUDGET=2000

# 全请求预算（TOKEN_BUDGET / CONTEXT_WINDOW_MAX_TOKENS 仍只管原有历史窗口）。
# 32768 是保守的运行上限，请按部署模型/通道的实际限制设置，不能超过模型限制。
CHAT_CONTEXT_LIMIT=32768
CHAT_OUTPUT_RESERVE=2048
# DeepSeek 等兼容接口使用 max_tokens；OpenAI 推理模型可改为 max_completion_tokens。
CHAT_OUTPUT_TOKEN_PARAMETER=max_tokens
CHAT_CONTEXT_SAFETY_MARGIN=1024
# 意图/摘要等模型可用精确模型名覆盖上限；未匹配使用 CHAT_CONTEXT_LIMIT。
CHAT_MODEL_CONTEXT_LIMITS={}

# ch02 数据库(复用本机 commerceflow-mysql 容器;全新环境用 docker compose up 起)
# 默认值与下面两行完全一致,不设也能正常工作
# DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/commerceflow
# TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/commerceflow_ch02_test

# ch08 工具系统
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
DEMO_TICKET_DELAY_SECONDS=0

# ch09 可观测(Langfuse 自部署;三者齐全才挂回调,缺省时系统照常跑)
# LANGFUSE_PUBLIC_KEY=pk-lf-commerceflow-local
# LANGFUSE_SECRET_KEY=sk-lf-commerceflow-local
# LANGFUSE_BASE_URL=http://localhost:3000

# ch11 identity. Supply a random >=32-byte signing secret via environment/secret manager.
AUTH_SIGNING_KEY=
AUTH_ISSUER=commerceflow
AUTH_AUDIENCE=commerceflow-web
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_REGISTRATION_ENABLED=false
# Keep true in production; only set false for local HTTP development.
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=[]
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
APPROVAL_TTL_SECONDS=300
TOOL_SECURITY_MODE=default
TOOL_ALLOW_BYPASS=false
# Local mock servers require an explicit development opt-in.
MCP_ALLOW_LOCAL_HTTP=false
MCP_LOGISTICS_TOKEN=
MCP_AFTERSALES_TOKEN=
MCP_SCHEMA_PINS={}
# RAG v2 灰度。完成双索引评测后再改为 v2；回滚改回 legacy 并重启。
KB_READ_MODEL=legacy
KB_V2_DUAL_WRITE=false
KB_V2_COLLECTION=knowledge_v2_test
