*.pyc
.env
# .env 的各种变体(备份、按环境分的副本)同样含真实密钥,必须一起挡住。
# 只放行 .env.example —— 它是对外发布的模板,里面只有占位符。
.env.*
!/.env.example
.pytest_cache/
.superpowers/
data/*.db*
data/*.sqlite*
dev-notes/
log/
logs/
*.pid
data/ch10/*
!data/ch10/reports

# 运行日志:后台页发起的作业与 dev.sh 启动日志,本地产物不入库
data/*.log
data/ch04/*.log

# Local pre-upgrade snapshots and tooling (no runtime secrets)
.security-upgrade-work/

